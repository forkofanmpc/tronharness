# TRON network: mainnet (forensics) or nile (delegation PoC)
NETWORK=mainnet

# TronGrid API key (recommended for rate limits)
TRON_GRID_API_KEY=

# Comma-separated Hex Trust-associated TRON addresses
TARGET_ADDRESSES=

# Sponsor wallet private key (Nile testnet only for delegation PoC)
SPONSOR_WALLET_PRIVATE_KEY=

# Delegate when address Energy drops below this threshold
ENERGY_THRESHOLD=100000

# Polling interval for delegation monitor (ms)
POLL_INTERVAL_MS=30000

# USDT TRC-20 contract (mainnet)
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Hex Safe API (optional — enables Module 2 probing)
HEX_TRUST_API_KEY=
HEX_ENTERPRISE_ID=
HEX_PRIVATE_KEY=
HEX_API_BASE_URL=https://api.sandbox.hexsafe.hextrust.com

# Fee audit / feasibility inputs
MONTHLY_TX_VOLUME=100
HEX_QUOTED_FEE_TRX=

# Omnibus pool size for Strategy C
OMNIBUS_POOL_SIZE=50

# Use TronScan as fallback for incomplete TronGrid pagination
USE_TRONSCAN_FALLBACK=false

# Local delegation state file
DELEGATION_STATE_PATH=delegation-state.json

# Opportunity cost APR for break-even sensitivity (0 = capital lockup only)
OPPORTUNITY_COST_APR=0
